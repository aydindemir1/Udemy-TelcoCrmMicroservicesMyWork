{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://eurekaserver:8761/eureka/",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true
    },
    "instance": {
      "appName": "invoiceservice",
      "hostName": "invoiceservice",
      "port": 5006,
      "preferIpAddress": false
    }
  },
  "ConnectionStrings": {
    "InvoiceDbConnection": "Host=invoicedb;Port=5432;Database=invoicedb;Username=admin;Password=123456;",
    "AuthRoleConnection": "authroledb:6379"
  },
  "OpenTelemetryOptions": {
    "Enabled": true,
    "AlwaysOnSampler": true,
    "Services": [
      "InvoiceService"
    ],
    "JaegerOptions": {
      "Endpoint": "http://jaeger:4318/v1/traces"
    }
  },
  "RabbitConfiguration": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123"
  },
  "Monitoring": {
    "BaseUrl": "http://invoiceservice:5006"
  },
  "TokenOptions": {
    "Audience": "test@test.com",
    "Issuer": "test@test.com",
    "AccessTokenExpiration": 500,
    "SecurityKey": "strongandsecretkeystrongandsecretkeystrongandsecretkeystrongandsecretkey",
    "RefreshTokenTTL": 2
  }
}