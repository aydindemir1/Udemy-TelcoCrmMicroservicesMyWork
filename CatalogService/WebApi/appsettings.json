    "instance": {
      "appName": "catalogservice",
      "hostName": "catalogservice",
      "port": 5003,
      "preferIpAddress": false
    }
  },
  "ConnectionStrings": {
    "CatalogDbConnection": "Server=catalogdb,1433;Database=CatalogDb;User Id=sa;Password=YourStrong!Pass123;TrustServerCertificate=True;",
    "HangfireConnection": "Server=catalogdb,1433;Database=HangfireDb;User Id=sa;Password=YourStrong!Pass123;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "AuthRoleConnection": "authroledb:6379"
  },
  "HangfireMessageSchedulerOptions": {
    "ConnectionString": "Server=catalogdb,1433;Database=HangfireDb;User Id=sa;Password=YourStrong!Pass123;TrustServerCertificate=True;MultipleActiveResultSets=true",
