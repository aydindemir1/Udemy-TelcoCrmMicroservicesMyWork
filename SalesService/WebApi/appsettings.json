{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://eurekaserver:8761/eureka/",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true
    },
    "instance": {
      "appName": "salesservice",
      "hostName": "salesservice",
      "port": 5005,
      "preferIpAddress": false
    }
  },
  "ConnectionStrings": {
    "AuthRoleConnection": "authroledb:6379"
  },
  "ExternalServices": {
    "BasketService": "http://basketservice",
    "CustomerService": "http://customerservice"
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://salesdb:27017",
    "DatabaseName": "SalesServiceDb"
  },
  "RabbitConfiguration": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123"
  },
  "OpenTelemetryOptions": {
    "Enabled": true,
    "AlwaysOnSampler": true,
    "Services": [
      "SalesService"
    ],
    "JaegerOptions": {
      "Endpoint": "http://jaeger:4318/v1/traces"
    }
  },
  "Monitoring": {
    "BaseUrl": "http://salesservice:5005"
  },
  "TokenOptions": {
    "Audience": "test@test.com",
    "Issuer": "test@test.com",
    "AccessTokenExpiration": 500,
    "SecurityKey": "strongandsecretkeystrongandsecretkeystrongandsecretkeystrongandsecretkey",
    "RefreshTokenTTL": 2
  },
  "PolicyOptions": {
    "RetryCount": 2,
    "BreakDuration": 5,
    "TimeOutDuration": 5000
  }
}