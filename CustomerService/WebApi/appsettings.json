{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://eurekaserver:8761/eureka/",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true
    },
    "instance": {
      "appName": "customerservice",
      "hostName": "customerservice",
      "port": 5001,
      "preferIpAddress": false
    }
  },
  "ConnectionStrings": {
    "CustomerDbConnection": "Host=customerdb;Port=5432;Database=customerdb;Username=admin;Password=123456",
    "AuthRoleConnection": "authroledb:6379"
  },
  "RabbitConfiguration": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123"
  },
  "OpenTelemetryOptions": {
    "Enabled": true,
    "AlwaysOnSampler": true,
    "Services": [
      "CustomerService"
    ],
    "JaegerOptions": {
      "Endpoint": "http://jaeger:4318/v1/traces"
    }
  },
  "Monitoring": {
    "BaseUrl": "http://customerservice:5001"
  },
  "OutboxOptions": {
    "ConnectionString": "Host=customerdb;Port=5432;Database=customerdb;Username=admin;Password=123456",
    "Enabled": true,
    "UseBackgroundDispatcher": true
  },
  "TokenOptions": {
    "Audience": "test@test.com",
    "Issuer": "test@test.com",
    "AccessTokenExpiration": 500,
    "SecurityKey": "strongandsecretkeystrongandsecretkeystrongandsecretkeystrongandsecretkey",
    "RefreshTokenTTL": 2
  }
}