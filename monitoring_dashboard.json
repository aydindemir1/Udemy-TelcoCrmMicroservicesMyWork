{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "8.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Genel Bakış (Uygulama Sağlığı)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Saniyedeki İstek Sayısı (RPS)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"
      },
      "pluginVersion": "9.2.5",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "continuous-GrYlRd" } }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "title": "Hata Oranı (%)",
      "type": "gauge",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total{job=~\"$job\", instance=~\"$instance\", code=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_received_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 100"
        }
      ]
    },
    {
      "title": "p95 Gecikme Süresi",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 500 }, { "color": "red", "value": 1000 } ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) by (le, job, instance)) * 1000",
          "legendFormat": "p95 Latency"
        }
      ]
    },
    {
      "title": "Bağımlılık Sağlık Durumu",
      "type": "barchart",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "options": { "orientation": "horizontal", "showValue": "always", "displayMode": "lcd" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "Healthy", "color": "green" }, "0.5": { "text": "Degraded", "color": "orange" }, "0": { "text": "Unhealthy", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "aspnetcore_healthcheck_status{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Performans Detayları",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "title": "İstek Gecikme Süreleri (Zaman Serisi)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "mean", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) by (le, job, instance)) * 1000",
          "legendFormat": "p99 - {{instance}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) by (le, job, instance)) * 1000",
          "legendFormat": "p95 - {{instance}}"
        },
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) by (job, instance) / sum(rate(http_requests_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) by (job, instance) * 1000",
          "legendFormat": "ortalama - {{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Entity Framework Core Analizi",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 }
    },
    {
      "title": "Saniyedeki Sorgu Sayısı",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "Qps", "custom": { "drawStyle": "bars", "fillOpacity": 100 } } },
      "targets": [
        {
          "expr": "sum(rate(microsoft_entityframeworkcore_microsoft_entityframeworkcore_queries{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) by (instance)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "title": "Veritabanı Yazma Oranı (SaveChanges/sn)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "options": {
        "legend": {
         "displayMode": "list",
         "placement": "bottom",
          "calcs": []
       },
       "tooltip": {
         "mode": "single",
         "sort": "none"
       }
     },
     "fieldConfig": {
       "defaults": {
         "unit": "short",
         "custom": {
           "drawStyle": "bars",
           "barAlignment": 0,
           "lineWidth": 1,
           "fillOpacity": 80,
           "gradientMode": "opacity",
           "axisPlacement": "auto",
           "axisLabel": "",
           "scaleDistribution": {
             "type": "linear"
           },
           "hideFrom": {
             "tooltip": false,
             "viz": false,
             "legend": false
           }
         },
         "color": {
           "mode": "palette-classic"
         }
       }
     },
     "targets": [
       {
         "expr": "sum(rate(microsoft_entityframeworkcore_microsoft_entityframeworkcore_savechanges{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) by(instance)",
         "legendFormat": "{{instance}}"
       }
      ]
    },
    {
      "type": "row",
      "title": ".NET Runtime Sağlığı",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 }
    },
    {
      "title": "GC Heap Boyutu (MB)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "megabytes", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 70 } } },
      "targets": [
        {
          "expr": "system_runtime_dotnet_gc_heap_total_allocated{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} - gen{{generation}}"
        }
      ]
    },
    {
      "title": "Fırlatılan Anlık Exception Sayısı",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 100, "lineColor": "red" },
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "expr": "rate(system_runtime_dotnet_exceptions{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{exception_type}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["dotnet", "aspnetcore", "custom","telco"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(job)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "job",
        "options": [],
        "query": { "query": "label_values(job)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(http_requests_received_total{job=~\"$job\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": { "query": "label_values(http_requests_received_total{job=~\"$job\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "TelcoCRM — Monitoring",
  "uid": "dotnet-monitoring-dashboard-v1",
  "version": 2
}